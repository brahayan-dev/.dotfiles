#!/usr/bin/env bash

if [[ "$(uname)" == "Darwin" ]]; then
  # NOTE: Path to binaries on Brew
  export PATH="/opt/homebrew/bin:$PATH"
fi

export JAVA_HOME="$HOME/Library/Caches/Coursier/arc/https/github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.10%252B7/OpenJDK21U-jdk_aarch64_mac_hotspot_21.0.10_7.tar.gz/jdk-21.0.10+7/Contents/Home"
export PATH="$PATH:$HOME/Library/Application Support/Coursier/bin"
